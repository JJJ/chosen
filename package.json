{
  "author": "jjj",
  "name": "chosen-jjj",
  "version": "3.0.4",
  "description": "Chosen is a JavaScript plugin that makes select boxes user-friendly. It is currently available in both jQuery and Prototype flavors.",
  "main": "dist/js/chosen.jquery.js",
  "style": "dist/css/chosen.css",
  "sideEffects": [
    "./dist/js/**",
    "./dist/core/index.iife.js",
    "./dist/css/**",
    "./dist/native/**",
    "./dist/scss/**",
    "./docs/**",
    "./coffee/**",
    "./sass/**",
    "./dist/react/chosen.css"
  ],
  "exports": {
    ".": "./dist/js/chosen.jquery.js",
    "./jquery": "./dist/js/chosen.jquery.js",
    "./prototype": "./dist/js/chosen.proto.js",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.mjs",
      "require": "./dist/native/index.cjs"
    },
    "./native/styles.css": "./dist/native/chosen.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs"
    },
    "./react/styles.css": "./dist/react/chosen.css",
    "./styles.css": "./dist/css/chosen.css",
    "./scss": "./dist/scss/chosen.scss",
    "./dist/*": "./dist/*",
    "./docs/*": "./docs/*",
    "./coffee/*": "./coffee/*",
    "./sass/*": "./sass/*",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist/",
    "docs/",
    "coffee/",
    "sass/",
    "CHANGELOG.md",
    "contributing.md",
    "composer.json"
  ],
  "keywords": [
    "select",
    "multiselect",
    "dropdown",
    "form",
    "input",
    "ui",
    "chosen",
    "jquery",
    "prototype"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJJ/chosen.git"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "test": "node scripts/build-demo-pages.js --check && grunt test && npm run test:native && node --test spec/core/*.test.mjs spec/module/*.test.mjs && tsc -p spec/core/tsconfig.json && node scripts/run-browser-specs.js && npm run test:react && npm run test:react-demo && npm run test:visual",
    "test:native": "node scripts/build-native.js && node --test spec/native/*.test.mjs && tsc -p spec/native/tsconfig.json && node scripts/run-native-browser-specs.js",
    "test:core": "grunt core && node --test spec/core/*.test.mjs && tsc -p spec/core/tsconfig.json",
    "test:jquery": "grunt test && node scripts/run-browser-specs.js jquery",
    "test:proto": "grunt test && node scripts/run-browser-specs.js proto",
    "test:mobile": "grunt test && node scripts/run-mobile-webkit.js",
    "test:react": "node scripts/build-react.js && node --test spec/react/*.test.mjs && tsc -p spec/react/tsconfig.json && node scripts/run-react-browser-specs.js",
    "test:react-demo": "node scripts/build-react.js && node scripts/build-react-demo.js && node scripts/run-react-demo-specs.js",
    "test:visual": "node scripts/run-visual-fixtures.js",
    "visual:fixtures": "node scripts/run-visual-fixtures.js --capture",
    "size:react": "node scripts/report-react-size.js",
    "triage:upstream": "node scripts/upstream-issues.js",
    "build": "grunt build && node scripts/build-native.js && node scripts/build-react.js && node scripts/build-react-demo.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "jquery": ">=1.7",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "jquery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "coffee-script": "^1.12.7",
    "esbuild": "^0.28.2",
    "grunt": "^1.6.3",
    "grunt-contrib-coffee": "^2.1.0",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-cssmin": "^5.0.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-dom-munger": "^4.0.0",
    "grunt-sass": "^4.1.0",
    "grunt-zip": "^1.0.0",
    "jasmine-core": "^7.0.2",
    "jquery": "^4.0.0",
    "jsdom": "^30.1.1",
    "load-grunt-tasks": "^5.1.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.1",
    "simulant": "^0.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tar-fs": "^3.0.4",
    "ws": "^8.17.1"
  },
  "contributors": [
    {
      "name": "John James Jacoby",
      "url": "https://github.com/JJJ"
    },
    {
      "name": "Patrick Filler",
      "url": "https://github.com/pfiller"
    },
    {
      "name": "Christophe Coevoet",
      "url": "https://github.com/stof"
    },
    {
      "name": "Ken Earley",
      "url": "https://github.com/kenearley"
    },
    {
      "name": "Koen Punt",
      "url": "https://github.com/koenpunt"
    }
  ],
  "license": "MIT",
  "homepage": "https://jjj.github.io/chosen/",
  "bugs": "https://github.com/JJJ/chosen/issues",
  "_extra": {
    "title": "Chosen",
    "license": {
      "type": "MIT",
      "url": "https://github.com/JJJ/chosen/blob/master/LICENSE.md"
    },
    "links": {
      "download": "https://github.com/JJJ/chosen/releases",
      "docs": "https://jjj.github.io/chosen/"
    },
    "main": [
      "dist/js/chosen.jquery.js",
      "dist/css/chosen.css"
    ]
  }
}
